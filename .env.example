# ════════════════════════════════════════════════
#  RISE Testnet — Helios Trade Volume Bot
#  Copy this file to .env and fill in your values
# ════════════════════════════════════════════════

# ── Wallet ──────────────────────────────────────
# ⚠️  Testnet ONLY — never use a wallet with real funds
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── RISE Testnet Network ─────────────────────────
# Chain ID : 11155931
# Explorer : https://explorer.testnet.risechain.com
# Faucet   : https://faucet.testnet.riselabs.xyz  OR  https://portal.risechain.com
RPC_URL=https://testnet.riselabs.xyz

# ── Helios Trade Contract Addresses ──────────────
# Find these by connecting your wallet on https://testnet.helios.trade
# and inspecting the swap transaction in the block explorer.
#
# The two key contracts for Uniswap V3-style DEXes are:
#   SwapRouter            — handles token swaps
#   NonfungiblePositionManager — handles adding/removing liquidity
#
# Example (replace with real Helios addresses once confirmed):
SWAP_ROUTER=0xYourHeliosSwapRouterAddress
POSITION_MANAGER=0xYourHeliosPositionManagerAddress

# ── Token Addresses (RISE Testnet) ───────────────
# WETH on RISE testnet (check block explorer or Helios UI)
WETH_ADDRESS=0xYourWETHAddressOnRiseTestnet

# Token to trade against WETH
# Known RISE testnet tokens (from docs.risechain.com):
#   USDC : 0x50524C5bDa18aE25C600a8b81449B9CeAeB50471
#   USDT : 0x9190159b1bb78482Dca6EBaDf03ab744de0c0197
#   BTC  : 0xadDAEd879D549E5DBfaf3e35470C20D8C50fDed0
TOKEN_ADDRESS=0x50524C5bDa18aE25C600a8b81449B9CeAeB50471

# ── Pool Settings ────────────────────────────────
# Uniswap V3 fee tier:
#   500   = 0.05%
#   3000  = 0.30% (most common)
#   10000 = 1.00%
POOL_FEE=3000

# ── Bot Settings ─────────────────────────────────
# How many buy+sell swap cycles to run
SWAP_ROUNDS=10
# ETH value per swap round
SWAP_AMOUNT_ETH=0.001
# Seconds to wait between rounds (RISE is fast — 12s is plenty)
DELAY_SECONDS=12
# Slippage tolerance % (0–100)
SLIPPAGE_PERCENT=5
# Transaction deadline in seconds from now
DEADLINE_OFFSET=300
