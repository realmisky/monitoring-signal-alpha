# ═══════════════════════════════════════════════════════════════
#  Helios Smart Volume Bot v3 — Live PnL & Risk Controls
# ═══════════════════════════════════════════════════════════════

# ── Wallet (TESTNET ONLY) ───────────────────────────────────────
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Network ─────────────────────────────────────────────────────
RPC_URL=https://testnet.riselabs.xyz

# ── Tokens to randomize ─────────────────────────────────────────
RANDOM_TOKENS=USDR,WBTC

# ── V3 fee tier: 500 (0.05%) | 3000 (0.3%) | 10000 (1%) ─────────
POOL_FEE=3000

# ── Smart Analyst ───────────────────────────────────────────────
# Spread (bps) that triggers an arb swap (50 = 0.5%)
ARB_THRESHOLD_BPS=50

# Force LP add after this many consecutive swaps
SWAP_TO_LP_RATIO=4

# Cap V3 swap size if estimated price impact > this (bps)
MAX_PRICE_IMPACT_BPS=100

# ── Risk Controls ───────────────────────────────────────────────
# Halt if total session loss > X% of starting balance
STOP_LOSS_PCT=5

# Skip rounds when wallet ETH balance falls below this
MIN_BALANCE_ETH=0.005

# ── Round Counts ────────────────────────────────────────────────
TOTAL_ROUNDS=15

# ── Random Amount Ranges (ETH) ──────────────────────────────────
MIN_SWAP_AMOUNT_ETH=0.0005
MAX_SWAP_AMOUNT_ETH=0.003
MIN_LP_AMOUNT_ETH=0.001
MAX_LP_AMOUNT_ETH=0.005

# ── Random Delays (seconds) ─────────────────────────────────────
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=25

# ── Slippage / Deadline ─────────────────────────────────────────
SLIPPAGE_PERCENT=5
DEADLINE_OFFSET=300

# ── Trade Log ───────────────────────────────────────────────────
TRADE_LOG_PATH=./trade-log.json
