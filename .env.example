# ═══════════════════════════════════════════════════════════════
#  Helios Trade Volume Bot — Randomized Edition
#  Copy this to .env and fill in your PRIVATE_KEY only.
# ═══════════════════════════════════════════════════════════════

# ── Wallet ──────────────────────────────────────────────────────
# ⚠️  TESTNET ONLY — never use a wallet with real funds
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Network ─────────────────────────────────────────────────────
RPC_URL=https://testnet.riselabs.xyz

# ── Random Token Selection ──────────────────────────────────────
# Comma-separated list of tokens to randomly pick from each round.
# Available: USDR, WBTC
RANDOM_TOKENS=USDR,WBTC

# ── Swap Engine ─────────────────────────────────────────────────
# v2  → only V2 router
# v3  → only V3 router
# both → randomly picks V2 or V3 each round (50/50)
SWAP_MODE=both

# V3 fee tier: 500 (0.05%) | 3000 (0.3%) | 10000 (1%)
POOL_FEE=3000

# ── Number of Rounds ────────────────────────────────────────────
SWAP_ROUNDS=10
LIQUIDITY_ROUNDS=3

# ── Random Amount Ranges (ETH) ──────────────────────────────────
# Bot picks a random amount within these bounds for each round
MIN_SWAP_AMOUNT_ETH=0.0005
MAX_SWAP_AMOUNT_ETH=0.003

MIN_LP_AMOUNT_ETH=0.001
MAX_LP_AMOUNT_ETH=0.005

# ── Random Delay Between Rounds (seconds) ───────────────────────
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=25

# ── Slippage & Deadline ─────────────────────────────────────────
SLIPPAGE_PERCENT=5
DEADLINE_OFFSET=300
