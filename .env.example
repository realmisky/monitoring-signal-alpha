# ─────────────────────────────────────────────
#  WALLET
# ─────────────────────────────────────────────
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ─────────────────────────────────────────────
#  RPC ENDPOINT  (pick your testnet)
# ─────────────────────────────────────────────
# Sepolia
RPC_URL=https://rpc.sepolia.org
# Polygon Mumbai
# RPC_URL=https://rpc-mumbai.maticvigil.com
# Arbitrum Sepolia
# RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ─────────────────────────────────────────────
#  DEX ROUTER  (Uniswap V2-compatible)
# ─────────────────────────────────────────────
# Uniswap V2 on Sepolia
ROUTER_ADDRESS=0xC532a74256D3Db42D0Bf7a0400fEFDbad7694008
# Sushiswap / Quickswap on Mumbai
# ROUTER_ADDRESS=0x1b02dA8Cb0d097eB8D57A175b88c7D8b47997506

# ─────────────────────────────────────────────
#  TOKEN PAIR TO TRADE
# ─────────────────────────────────────────────
# Token A  (e.g. WETH on Sepolia)
TOKEN_A=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9
# Token B  (e.g. a testnet ERC-20 / USDC mock)
TOKEN_B=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ─────────────────────────────────────────────
#  BOT SETTINGS
# ─────────────────────────────────────────────
# How many swap rounds to run
SWAP_ROUNDS=10
# ETH value per swap (in ether units)
SWAP_AMOUNT_ETH=0.001
# Seconds to wait between each action
DELAY_SECONDS=15
# Slippage tolerance (0–100, e.g. 5 = 5%)
SLIPPAGE_PERCENT=5
# Deadline offset in seconds from now
DEADLINE_OFFSET=300
