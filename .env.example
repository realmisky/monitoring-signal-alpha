# ═══════════════════════════════════════════════════════════════
#  Helios Trade Smart Volume Bot
#  Copy this to .env and fill in your PRIVATE_KEY only.
# ═══════════════════════════════════════════════════════════════

# ── Wallet (TESTNET ONLY) ───────────────────────────────────────
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Network ─────────────────────────────────────────────────────
RPC_URL=https://testnet.riselabs.xyz

# ── Tokens to randomly pick from each round ─────────────────────
# Available: USDR, WBTC
RANDOM_TOKENS=USDR,WBTC

# ── V3 fee tier: 500 (0.05%) | 3000 (0.3%) | 10000 (1%) ─────────
POOL_FEE=3000

# ── Smart Analyst Settings ──────────────────────────────────────
# How many BPS spread triggers an arbitrage swap (50 = 0.5%)
ARB_THRESHOLD_BPS=50

# After this many consecutive swaps, force an LP add for rebalance
SWAP_TO_LP_RATIO=4

# ── Round counts ────────────────────────────────────────────────
# Total rounds — analyst decides swap vs LP each one
TOTAL_ROUNDS=15

# ── Random Amount Ranges (ETH) ──────────────────────────────────
MIN_SWAP_AMOUNT_ETH=0.0005
MAX_SWAP_AMOUNT_ETH=0.003

MIN_LP_AMOUNT_ETH=0.001
MAX_LP_AMOUNT_ETH=0.005

# ── Random Delay Between Rounds (seconds) ───────────────────────
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=25

# ── Slippage & Deadline ─────────────────────────────────────────
SLIPPAGE_PERCENT=5
DEADLINE_OFFSET=300
