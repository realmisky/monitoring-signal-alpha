# ═══════════════════════════════════════════════════════════════
#  Helios Trade (AsterSwap) — RISE Testnet Volume Bot
#  Copy this to .env and fill in your PRIVATE_KEY only.
#  Everything else is pre-filled with real contract addresses.
# ═══════════════════════════════════════════════════════════════

# ── Wallet ──────────────────────────────────────────────────────
# ⚠️  TESTNET ONLY — never use a wallet with real funds
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Network ─────────────────────────────────────────────────────
# Chain ID : 11155931
# Explorer : https://explorer.testnet.riselabs.xyz
# Faucet   : https://portal.risechain.com
RPC_URL=https://testnet.riselabs.xyz

# ── Helios / AsterSwap Contract Addresses (pre-filled) ──────────

# Uniswap V2 Router
V2_ROUTER=0x10d48ce98bdf05be9dafa8d61f147a559c23ab85

# Uniswap V3 SwapRouter
V3_SWAP_ROUTER=0xdcc105b5aa8ed0a9e19907b7f606be94167f4e43

# Uniswap V3 QuoterV2
V3_QUOTER=0x009c4554f445dfa2e757d9f0452dc7dcc444729a

# Uniswap V3 NonfungiblePositionManager
POSITION_MANAGER=0x1b4d07bdfc807dfe4c32b13bc60d009e35b2749b

# ── Token Addresses (pre-filled) ────────────────────────────────

# Wrapped ETH (OP-style canonical WETH on RISE)
WETH=0x4200000000000000000000000000000000000006

# USD Rise — USDR (6 decimals)
USDR=0x04ed985f0246f00e4e9d158a70a6469e258def05

# Wrapped Bitcoin — WBTC (18 decimals)
WBTC=0xf32d39ff9f6aa7a7a64d7a4f00a54826ef791a55

# ── Pool / Swap Settings ─────────────────────────────────────────

# Which swap engine to use: v2 | v3 | both (alternates V2/V3 each round)
SWAP_MODE=both

# Uniswap V3 fee tier: 500 (0.05%) | 3000 (0.3%) | 10000 (1%)
POOL_FEE=3000

# ── Bot Behaviour ────────────────────────────────────────────────

# Number of buy+sell swap cycles to run
SWAP_ROUNDS=10

# ETH spent per swap round
SWAP_AMOUNT_ETH=0.001

# Seconds to wait between rounds (RISE is fast — 12s is fine)
DELAY_SECONDS=12

# Slippage tolerance in percent (0–100)
SLIPPAGE_PERCENT=5

# Transaction deadline: seconds added to current timestamp
DEADLINE_OFFSET=300
